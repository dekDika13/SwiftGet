{
  "manifest_version": 3,
  "name": "SwiftGet Integration",
  "version": "1.0.0",
  "description": "Kirim unduhan dan video dari browser ke aplikasi SwiftGet.",
  "permissions": ["downloads", "contextMenus", "storage", "cookies", "webRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true }
  ],
  "action": { "default_popup": "popup.html", "default_title": "SwiftGet" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "browser_specific_settings": { "gecko": { "id": "swiftget@local", "strict_min_version": "115.0" } }
}
